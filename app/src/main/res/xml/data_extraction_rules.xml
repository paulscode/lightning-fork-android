<?xml version="1.0" encoding="utf-8"?>
<!-- Nothing leaves the phone in a cloud backup or a device transfer: the key
     is bound to this phone's Keystore and could not be read elsewhere anyway. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" />
        <exclude domain="sharedpref" />
        <exclude domain="database" />
        <exclude domain="file" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" />
        <exclude domain="sharedpref" />
        <exclude domain="database" />
        <exclude domain="file" />
    </device-transfer>
</data-extraction-rules>
