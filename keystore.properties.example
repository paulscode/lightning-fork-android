# Copy to `keystore.properties` (gitignored) ONLY if you want Gradle to sign
# release builds on this machine. For the air-gapped flow (recommended) leave
# this file absent: `assembleRelease`/`bundleRelease` then produce UNSIGNED
# artifacts that you sign offline with the upload key (see RELEASE.md).
storeFile=/absolute/path/to/lf-upload.jks
storePassword=CHANGE_ME
keyAlias=lf-upload
keyPassword=CHANGE_ME
